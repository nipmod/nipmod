{
  "name": "nipmod",
  "version": "1.2.9",
  "description": "Search packages, inspect trust and get safe install plans for humans and AI agents.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "type": "module",
  "bin": {
    "nipmod": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nipmod/nipmod.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/nipmod/nipmod/issues"
  },
  "homepage": "https://nipmod.com/cli",
  "keywords": [
    "ai-agents",
    "mcp",
    "package-search",
    "sandbox",
    "software-security",
    "supply-chain"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "security:deps": "pnpm audit --audit-level high",
    "test": "vitest run --testTimeout 20000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@scure/base": "^2.2.0",
    "@vercel/sandbox": "^2.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
